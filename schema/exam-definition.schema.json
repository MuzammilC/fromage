{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuzammilC/fromage/schema/exam-definition.schema.json",
  "title": "ExamDefinition",
  "description": "The versioned description of one exam format: its Level, its Parts in order, the timings and the Grid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "level", "parts", "grid", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Part" }
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Criterion" }
    },
    "provenance": { "$ref": "#/$defs/Provenance" }
  },
  "$defs": {
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "prep_time_seconds",
        "target_duration_seconds",
        "turn_mode"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "prep_time_seconds": { "type": "integer", "minimum": 0 },
        "target_duration_seconds": { "type": "integer", "minimum": 1 },
        "turn_mode": { "enum": ["interactive", "listen_only"] }
      }
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "band_points"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "scope": { "$ref": "#/$defs/Scope" },
        "band_points": {
          "description": "Points for Band 0, 1, 2 and 3, in order. Starts at 0 and never decreases.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        }
      }
    },
    "Scope": {
      "anyOf": [
        {
          "title": "PartScope",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "part"],
          "properties": {
            "kind": { "const": "part" },
            "part": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
          }
        },
        {
          "title": "GlobalScope",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "global" } }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "retrieved_on"],
      "properties": {
        "source_url": { "type": "string", "format": "uri" },
        "retrieved_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
