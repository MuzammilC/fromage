{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuzammilC/fromage/schema/exam-definition.schema.json",
  "title": "ExamDefinition",
  "description": "The versioned description of one exam format: its Level, its Parts in order, the timings and the Grid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "level", "parts", "grid", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Part" }
    },
    "prep_periods": {
      "description": "Prep Time before the live Parts. Omit when the exam has none.",
      "type": "array",
      "items": { "$ref": "#/$defs/PrepPeriod" }
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Criterion" }
    },
    "provenance": { "$ref": "#/$defs/Provenance" }
  },
  "$defs": {
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "target_duration_seconds", "turn_mode"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "target_duration_seconds": { "$ref": "#/$defs/DurationRange" },
        "turn_mode": { "enum": ["interactive", "listen_only"] },
        "item_type": {
          "description": "The one Item type a Candidate is given in this Part.",
          "enum": [
            "question_bank",
            "monologue_subject",
            "interaction_situation"
          ]
        },
        "announcement": {
          "description": "The fixed French line the Examiner says when this Part starts. Omit to use a generic line.",
          "type": "string",
          "minLength": 1
        },
        "draw_count": {
          "description": "How many Items the Candidate is offered in a Draw for this Part, keeping one. Omit when the Part has no Draw. Needs an item_type.",
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "DurationRange": {
      "description": "Target live time in seconds. Use the same number for min and max when the exam gives a single approximate time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "PrepPeriod": {
      "description": "One timed Prep Time before the live Parts, shared by the Parts it covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["time_seconds", "parts"],
      "properties": {
        "time_seconds": { "type": "integer", "minimum": 1 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
        }
      }
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "band_points"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "scope": { "$ref": "#/$defs/Scope" },
        "band_points": {
          "description": "Points for Band 0, 1, 2 and 3, in order. Starts at 0 and never decreases.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "descriptors": { "$ref": "#/$defs/Descriptors" }
      }
    },
    "Descriptors": {
      "description": "Paraphrased performance descriptors for Bands 1 to 3. Never copied from official text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["band_1", "band_2", "band_3"],
      "properties": {
        "band_1": { "type": "string", "minLength": 1 },
        "band_2": { "type": "string", "minLength": 1 },
        "band_3": { "type": "string", "minLength": 1 }
      }
    },
    "Scope": {
      "anyOf": [
        {
          "title": "PartScope",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "part"],
          "properties": {
            "kind": { "const": "part" },
            "part": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
          }
        },
        {
          "title": "GlobalScope",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "global" } }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "retrieved_on"],
      "properties": {
        "source_url": { "type": "string", "format": "uri" },
        "retrieved_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "links": {
          "description": "Further sources the definition was built from.",
          "type": "array",
          "items": { "$ref": "#/$defs/SourceLink" }
        }
      }
    },
    "SourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
