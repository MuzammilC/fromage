# Copy to `.env` at the repo root. The web app, the agent, the grader and gen-items all read this one file.

# Anthropic (gen-items, agent, grader)
ANTHROPIC_API_KEY=

# Langfuse (tracing)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Deepgram (speech-to-text)
DEEPGRAM_KEY=

# Supabase (local values come from `supabase status`)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
