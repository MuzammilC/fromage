{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuzammilC/fromage/schema/item.schema.json",
  "title": "Item",
  "description": "One original brief a Candidate can be given for a Part. The `type` says which kind.",
  "anyOf": [
    { "$ref": "#/$defs/QuestionBank" },
    { "$ref": "#/$defs/MonologueSubject" },
    { "$ref": "#/$defs/InteractionSituation" }
  ],
  "$defs": {
    "QuestionBank": {
      "description": "The questions the Examiner draws from in the guided interview (A2 Part 1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "exam_definition",
        "part_key",
        "topics",
        "status",
        "version",
        "generation",
        "teacher_reviewed",
        "questions"
      ],
      "properties": {
        "type": { "const": "question_bank" },
        "id": { "$ref": "#/$defs/ItemId" },
        "exam_definition": { "$ref": "#/$defs/ExamDefinitionRef" },
        "part_key": { "$ref": "#/$defs/Key" },
        "topics": { "$ref": "#/$defs/Topics" },
        "status": { "$ref": "#/$defs/Status" },
        "version": { "type": "integer", "minimum": 1 },
        "generation": { "$ref": "#/$defs/Generation" },
        "teacher_reviewed": { "const": false },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "MonologueSubject": {
      "description": "A subject the Candidate speaks on continuously (A2 Part 2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "exam_definition",
        "part_key",
        "topics",
        "status",
        "version",
        "generation",
        "teacher_reviewed",
        "candidate_brief",
        "suggested_angles"
      ],
      "properties": {
        "type": { "const": "monologue_subject" },
        "id": { "$ref": "#/$defs/ItemId" },
        "exam_definition": { "$ref": "#/$defs/ExamDefinitionRef" },
        "part_key": { "$ref": "#/$defs/Key" },
        "topics": { "$ref": "#/$defs/Topics" },
        "status": { "$ref": "#/$defs/Status" },
        "version": { "type": "integer", "minimum": 1 },
        "generation": { "$ref": "#/$defs/Generation" },
        "teacher_reviewed": { "const": false },
        "candidate_brief": { "type": "string", "minLength": 1 },
        "suggested_angles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "InteractionSituation": {
      "description": "An everyday situation the Candidate resolves with the Examiner (A2 Part 3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "exam_definition",
        "part_key",
        "topics",
        "status",
        "version",
        "generation",
        "teacher_reviewed",
        "candidate_brief",
        "examiner_role",
        "examiner_only_data",
        "expected_speech_acts",
        "register"
      ],
      "properties": {
        "type": { "const": "interaction_situation" },
        "id": { "$ref": "#/$defs/ItemId" },
        "exam_definition": { "$ref": "#/$defs/ExamDefinitionRef" },
        "part_key": { "$ref": "#/$defs/Key" },
        "topics": { "$ref": "#/$defs/Topics" },
        "status": { "$ref": "#/$defs/Status" },
        "version": { "type": "integer", "minimum": 1 },
        "generation": { "$ref": "#/$defs/Generation" },
        "teacher_reviewed": { "const": false },
        "candidate_brief": { "type": "string", "minLength": 1 },
        "examiner_role": { "type": "string", "minLength": 1 },
        "examiner_only_data": {
          "description": "Facts only the Examiner knows, such as a price list or a timetable.",
          "type": "object"
        },
        "expected_speech_acts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "register": { "enum": ["formal", "informal"] }
      }
    },
    "ItemId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "Key": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
    "ExamDefinitionRef": {
      "description": "The Exam Definition this Item belongs to, as `id@version`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "Topics": {
      "description": "Topic Taxonomy entries for this Item.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
    },
    "Status": { "enum": ["draft", "reviewed", "retired"] },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "date"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
